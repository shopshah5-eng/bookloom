{
  "$schema": "https://tr.designtokens.org/format/",
  "icon": {
    "size": {
      "xs": { "$type": "dimension", "$value": "16px" },
      "sm": { "$type": "dimension", "$value": "20px" },
      "md": { "$type": "dimension", "$value": "24px" },
      "lg": { "$type": "dimension", "$value": "32px" },
      "xl": { "$type": "dimension", "$value": "48px" },
      "2xl": { "$type": "dimension", "$value": "64px" }
    },
    "stroke": {
      "small": { "$type": "dimension", "$value": "1.5px" },
      "default": { "$type": "dimension", "$value": "1.75px" },
      "large": { "$type": "dimension", "$value": "2px" }
    }
  }
}
