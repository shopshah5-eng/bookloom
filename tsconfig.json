{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@bookloom/ui": ["./packages/ui/index.ts"],
      "@bookloom/editor": ["./packages/editor/index.ts"],
      "@bookloom/ai": ["./packages/ai/index.ts"],
      "@bookloom/auth": ["./packages/auth/index.ts"],
      "@bookloom/publishing": ["./packages/publishing/index.ts"],
      "@bookloom/platform": ["./packages/platform/index.ts"],
      "@bookloom/types": ["./packages/types/index.ts"],
      "@bookloom/validation": ["./packages/validation/index.ts"],
      "@bookloom/design-tokens": ["./packages/design-tokens/index.ts"],
      "@bookloom/config": ["./packages/config/index.ts"],
      "@bookloom/database": ["./packages/database/index.ts"],
      "@bookloom/*": ["./packages/*/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
